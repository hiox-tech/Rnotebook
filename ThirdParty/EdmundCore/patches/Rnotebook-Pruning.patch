-        // back-to-front at the end so earlier ranges stay valid.
-        var edits: [(NSRange, String)] = []
-
-        for block in BlockParser.parse(markdown, features: features) {
-            switch block.kind {
-            case .fence, .indentedCode, .mathDisplay, .multiBlockComment:
-                continue
-            default:
