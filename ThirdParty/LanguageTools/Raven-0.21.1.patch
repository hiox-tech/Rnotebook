+    // Called on a blocking worker. Serialize misses, then recheck the cache;
+    // this also coalesces concurrent lookups for the same function.
+    pub fn query_package(&self, function: &str, package: &str, internal: bool,
+                         r: &crate::r_subprocess::RSubprocess) -> Option<FunctionSignature> {
+        let key = format!("{}::{}", package, function);
+        if let Some(hit) = self.get_package(&key) { return Some(hit); }
+        let _guard = self.lookup_gate.lock().ok()?;
+        if let Some(hit) = self.get_package(&key) { return Some(hit); }
+        if self.failures.read().ok()?.peek(&key)
+            .is_some_and(|at| at.elapsed() < std::time::Duration::from_secs(5)) { return None; }
+        let handle = tokio::runtime::Handle::try_current().ok()?;
+        match handle.block_on(r.get_function_formals(function, Some(package), !internal)) {
+            Ok(parameters) => {
+                let value = FunctionSignature { name: function.to_string(), parameters,
+                    source: SignatureSource::RSubprocess { package: Some(package.to_string()) } };
+                self.insert_package(key, value.clone());
+                Some(value)
+            }
+            Err(_) => {
+                self.failures.write().ok()?.push(key, std::time::Instant::now());
+                None
+            }
         }
     }
 }
