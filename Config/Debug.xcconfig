MACOSX_DEPLOYMENT_TARGET = 14.0
ARCHS = arm64
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
CLANG_ENABLE_MODULES = YES
SWIFT_OPTIMIZATION_LEVEL = -Onone
DEBUG_INFORMATION_FORMAT = dwarf
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
ENABLE_APP_SANDBOX = NO
CODE_SIGNING_ALLOWED = YES
CODE_SIGN_IDENTITY = -
CODE_SIGN_STYLE = Manual

// A separate identity for offscreen tests keeps interactive previews running.
KAIL_PREVIEW_TEST_SUFFIX =

SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/DesktopApp/LanguageServices/TreeSitterBridge.h
HEADER_SEARCH_PATHS = $(inherited) $(SRCROOT)/ThirdParty/LanguageTools/TreeSitter/lib/include

OTHER_SWIFT_FLAGS = $(inherited) -Xfrontend -debug-prefix-map -Xfrontend $(SRCROOT)=/Rnotebook -Xfrontend -file-prefix-map -Xfrontend $(SRCROOT)=/Rnotebook
OTHER_CFLAGS = $(inherited) -fdebug-prefix-map=$(SRCROOT)=/Rnotebook -fmacro-prefix-map=$(SRCROOT)=/Rnotebook -ffile-prefix-map=$(SRCROOT)=/Rnotebook
